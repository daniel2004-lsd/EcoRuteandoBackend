# Plantilla de variables de entorno para EcoRuteando Backend
# Copia este archivo a .env y completa los valores reales.
# El archivo .env NUNCA se sube al repositorio ni debe contener credenciales reales.

# Base de datos (PostgreSQL)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=ecoRuteando_db
DB_USERNAME=your_db_username_here
DB_PASSWORD=your_db_password_here

# Entorno y puerto del servicio
ASPNETCORE_ENVIRONMENT=Production
PORT=5124

# JWT
Jwt__Issuer=EcoRuteando
Jwt__Audience=EcoRuteandoUsers
Jwt__SecretKey=your_jwt_secret_key_minimum_32_characters_here
Jwt__ExpirationMinutes=15

# Administrador inicial (opcional - bootstrap automático en primer arranque)
Admin__Email=
Admin__Password=

# Correo (SMTP)
EmailSettings__Host=smtp.gmail.com
EmailSettings__Port=587
EmailSettings__EnableSsl=true
EmailSettings__Username=
EmailSettings__Password=
EmailSettings__FromName=EcoRuteando
EmailSettings__FromEmail=

# Google OAuth
Google__ClientId=
Google__ClientSecret=

# Facebook OAuth
Facebook__AppId=
Facebook__AppSecret=

# Google Maps API
GoogleMaps__ApiKey=

# Proxy inverso / Forwarded Headers (opcional)
# Define la IP o red CIDR confiable del proxy inverso si aplica (ej. red Docker: 172.16.0.0/12).
# Dejar vacío si no se usa proxy intermedio para confiar únicamente en loopback seguro.
FORWARDED_KNOWN_PROXIES=
FORWARDED_KNOWN_NETWORKS=
FORWARDED_LIMIT=1
