# Plantilla de variables de entorno para EcoRuteando Backend
# Copia este archivo a .env y completa los valores reales.
# El archivo .env NUNCA se sube al repositorio.

# Base de datos (PostgreSQL del docker-compose de EcoRuteandoDb)
ConnectionStrings__DefaultConnection=Host=postgres;Port=5432;Database=ecoRuteando_db;Username=postgres;Password=postgres

# JWT
Jwt__Issuer=EcoRuteando
Jwt__Audience=EcoRuteandoUsers
Jwt__SecretKey=
Jwt__ExpirationMinutes=60

# Correo (SMTP)
EmailSettings__Username=
EmailSettings__Password=
EmailSettings__FromEmail=

# Google OAuth
Google__ClientId=
Google__ClientSecret=

# Facebook OAuth
Facebook__AppId=
Facebook__AppSecret=
