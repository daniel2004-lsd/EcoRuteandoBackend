@host = https://localhost:7076
@authToken = YOUR_AUTH_BEARER_TOKEN
@testUserId = 00000000-0000-0000-0000-000000000000
@testRoleId = 00000000-0000-0000-0000-000000000000
@testEmail = user@example.com
@testPassword = Password123!

### Login
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "email": "{{testEmail}}",
  "password": "{{testPassword}}"
}

### Test privado
GET {{host}}/api/test/private
Authorization: Bearer {{authToken}}

### Obtener usuarios
GET {{host}}/api/users
Authorization: Bearer {{authToken}}

### Obtener usuario por id
GET {{host}}/api/users/{{testUserId}}
Authorization: Bearer {{authToken}}

### Obtener roles
GET {{host}}/api/roles
Authorization: Bearer {{authToken}}

### Actualizar rol
PUT {{host}}/api/roles/{{testRoleId}}
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "name": "User",
  "description": "Usuario Estandar"
}

### Obtener permisos
GET {{host}}/api/permissions
Authorization: Bearer {{authToken}}

### Asignar rol a un usuario
POST {{host}}/api/userroles
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "userId": "{{testUserId}}",
  "roleId": "{{testRoleId}}"
}

### Obtener roles de un usuario
GET {{host}}/api/userroles/{{testUserId}}
Authorization: Bearer {{authToken}}

### Eliminar rol de un usuario
DELETE {{host}}/api/userroles/{{testUserId}}/{{testRoleId}}
Authorization: Bearer {{authToken}}
